{
  "name": "@wyrcan/gamr",
  "version": "0.3.2",
  "description": "Terminal games for xterm.js and CLI — snake, 2048, pong, asteroids, tetris, and more",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gamr": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    },
    "./playtest": {
      "types": "./dist/playtest.d.ts",
      "import": "./dist/playtest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "playtest": "npm run build && node scripts/playtest.mjs",
    "start": "node scripts/start.mjs",
    "start:build": "npm run build && npm run start",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@xterm/xterm": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/xterm": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyrcan-io/gamr.git"
  },
  "homepage": "https://github.com/Wyrcan-io/gamr#readme",
  "bugs": {
    "url": "https://github.com/Wyrcan-io/gamr/issues"
  },
  "keywords": [
    "terminal",
    "games",
    "cli",
    "xterm",
    "snake",
    "tetris",
    "2048",
    "pong",
    "asteroids"
  ],
  "author": "wyrcan.io",
  "dependencies": {
    "@clack/prompts": "^1.0.1"
  }
}
